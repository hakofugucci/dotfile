/* ============================================================
 * waybar config (Tokyo Night Storm)
 * 対応する style.css: 左 = #workspaces, #window
 *                     右 = #network, #disk, #memory, #cpu, #pulseaudio, #clock
 * 色・角丸・余白(上下)は style.css 側で管理する。
 * ============================================================ */
{
    // ---------- バー全体 ----------
    "layer": "top",
    "position": "bottom",
    "height": 46,

    // 左右・下の余白はここで指定(style.css は上下 5px のみ)
    "margin-left": 8,
    "margin-right": 8,
    "margin-bottom": 4,

    // モジュール間の隙間。右側を「ひとつながりの帯」にするので 0
    "spacing": 0,

    // ---------- 配置 ----------
    // 右の並び順は style.css の角丸設定(network=左端 / clock=右端)と対応
    "modules-left": ["sway/workspaces", "sway/window"],
    "modules-right": ["network", "disk", "memory", "cpu", "pulseaudio", "clock"],

    // ---------- 左: ワークスペース ----------
    "sway/workspaces": {
        "disable-scroll": true,

        // 常設WS: 1-2 は HDMI-A-1、3-7 は DP-3
        "persistent-workspaces": {
            "1": ["HDMI-A-1"],
            "2": ["HDMI-A-1"],
            "3": ["DP-3"],
            "4": ["DP-3"],
            "5": ["DP-3"],
            "6": ["DP-3"],
            "7": ["DP-3"]
        },

        // 「番号 + 開いているアプリのアイコン」の表示
        // アイコン同士の間隔は window-format の先頭の空白(\u2002 = 半角幅のenスペース)で作る。
        // 詰まりすぎ/広すぎは \u2002 を \u2003(emスペース)や "\u2002\u2002" に変えて調整。
        "format": "<span size='large' weight='heavy'>{name}</span>{windows}",
        "window-format": "\u2002{window}",

        // 下の一覧にないアプリは汎用アイコン
        "window-rewrite-default": "\uf2d0",
        "window-rewrite": {
            // 開発・ターミナル
            "class<com.mitchellh.ghostty>": "\uf120", // ターミナル
            "class<code|Code|codium>":      "\uf121", // エディタ (VS Code 系)

            // ブラウザ
            "class<brave.*>":               "\uf0ac",
            "class<firefox.*|Firefox.*>":   "\uf269",
            "class<chromium|[Gg]oogle-chrome>": "\uf268",

            // 知識・学習
            "class<obsidian>":              "\uf15c", // ノート
            "class<anki>":                  "\uf24d", // 暗記カード
            "class<[Zz]otero>":             "\uf02d", // 文献管理
            "class<org.pwmt.zathura|[Ee]vince|[Oo]kular>": "\uf1c1", // PDF

            // コミュニケーション
            "class<discord|vesktop>":       "\uf392",
            "class<[Ss]lack>":              "\uf198",
            "class<[Tt]elegram.*>":         "\uf2c6",
            "class<[Ll]ine>":               "\uf075",
            "class<thunderbird>":           "\uf0e0", // メール

            // メディア
            "class<spotify>":               "\uf1bc",
            "class<mpv|vlc>":               "\uf03d", // 動画
            "class<imv|feh|org.gnome.Loupe>": "\uf03e", // 画像

            // その他
            "class<thunar|Thunar|org.gnome.Nautilus|pcmanfm>": "\uf07b", // ファイル管理
            "class<pavucontrol>":           "\uf028", // 音量
            "class<steam>":                 "\uf1b6"
        }
    },

    // ---------- 左: アクティブウィンドウ ----------
    "sway/window": {
        "format": "{app_id}",
        "max-length": 24,
        "min-length": 14,
        "align": 0.5
    },

    // ---------- 右: ステータス ----------
    // min-length + align 0.5 で幅を固定し、値が変わっても帯が揺れないようにする

    "network": {
        "format-ethernet": "<span size='large'>\uf0ec</span>  NET {bandwidthDownBytes}",
        "format-wifi": "<span size='large'>\uf1eb</span>  NET {essid}",
        "format-disconnected": "<span size='large'>\uf127</span>  NET offline", // style.css の #network.disconnected で赤
        "interval": 2,
        "min-length": 14,
        "align": 0.5
    },

    "disk": {
        "format": "<span size='large'>\uf0a0</span>  DISK {percentage_used:>3}%",
        "path": "/",
        "interval": 120,
        "min-length": 13,
        "align": 0.5
    },

    "memory": {
        "format": "<span size='large'>\uefc5</span>  RAM {percentage:>3}%",
        "interval": 10,
        "min-length": 12,
        "align": 0.5
    },

    "cpu": {
        "format": "<span size='large'>\uf2db</span>  CPU {usage:>3}%",
        "interval": 5,
        "min-length": 12,
        "align": 0.5
    },

    "pulseaudio": {
        "format": "<span size='large'>{icon}</span>  VOL {volume:>3}%",
        "format-muted": "<span size='large'>\uf026</span>  mute", // style.css の #pulseaudio.muted で薄色
        "format-icons": {
            "default": ["\uf027", "\uf028"]
        },
        "min-length": 12,
        "align": 0.5
    },

    "clock": {
        "format": "<span size='large'>\uf017</span>  {:%m/%d %a %H:%M:%S}",
        "interval": 1, // 秒表示なので 1 秒更新
        "min-length": 22,
        "align": 0.5
    }
}
