{
  "layer": "top",
  "position": "bottom",
  "height": 46,
  "margin-left": 8,
  "margin-right": 8,
  "margin-bottom": 4,
  "spacing": 0,
  "modules-left": ["sway/workspaces", "sway/window"],
  "modules-right": ["network", "disk", "memory", "cpu", "pulseaudio", "clock"],
  "sway/workspaces": {
    "disable-scroll": true,
    "persistent-workspaces": { "1": ["HDMI-A-1"], "2": ["HDMI-A-1"], "3": ["DP-3"], "4": ["DP-3"], "5": ["DP-3"], "6": ["DP-3"], "7": ["DP-3"] },
    "format": "{name} {windows}",
    "window-format": "{window}",
    "window-rewrite-default": "\uf2d0",
    "window-rewrite": {
      "class<com.mitchellh.ghostty>": "\uf120",
      "class<brave.*>": "\uf0ac",
      "class<obsidian>": "\uf15c",
      "class<anki>": "\uf24d",
      "class<[Zz]otero>": "\uf02d",
      "class<discord>": "\uf392",
      "class<spotify>": "\uf1bc"
    }
  },
  "sway/window": { "format": "{app_id}", "max-length": 24, "min-length": 14, "align": 0.5 },
  "network": {
    "format-ethernet": "\uf0ec  NET {bandwidthDownBytes}",
    "format-wifi": "\uf1eb  NET {essid}",
    "format-disconnected": "\uf127  NET offline",
    "interval": 2,
    "min-length": 14,
    "align": 0.5
  },
  "disk": { "format": "\uf0a0  DISK {percentage_used:>3}%", "path": "/", "interval": 120, "min-length": 13, "align": 0.5 },
  "memory": { "format": "\uefc5  RAM {percentage:>3}%", "interval": 10, "min-length": 12, "align": 0.5 },
  "cpu": { "format": "\uf2db  CPU {usage:>3}%", "interval": 5, "min-length": 12, "align": 0.5 },
  "pulseaudio": {
    "format": "{icon}  VOL {volume:>3}%",
    "format-muted": "\uf026  mute",
    "format-icons": { "default": ["\uf027", "\uf028"] },
    "min-length": 12,
    "align": 0.5
  },
  "clock": { "format": "\uf017  {:%m/%d %a %H:%M:%S}", "interval": 1, "min-length": 22, "align": 0.5 }
}
